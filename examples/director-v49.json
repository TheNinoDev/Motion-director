      "offset": 1.0
    },
    {
      "id": "settle",
      "after": "answer",
      "offset": 1.2
    },
    {
      "id": "press",
      "after": "settle",
      "offset": 0.8
    }
  ],
  "sequences": [
    {
      "id": "titlechange",
      "recipe": "masked_handoff",
      "marker": "focus",
      "offset": 0,
      "duration": 0.75,
      "bind": {
        "incoming": "title2",
        "outgoing": "title"
      },
      "params": {
        "exit_x": -100,
        "entry_x": 360
      }
    },
    {
      "id": "detail",
      "recipe": "proof_detail",
      "marker": "focus",
      "offset": 0,
      "duration": 1.2,
      "bind": {
        "product": "panel",
        "annotation": "annotation"
      },
      "params": {
        "zoom": 1.1,
        "target_x": 360,
        "target_y": 630
      }
    },
    {
      "id": "semantic",
      "recipe": "trace_then_label",
      "marker": "settle",
      "offset": 0,
      "duration": 0.8,
      "bind": {
        "trace": "detail_line",
        "label": "label"
      },
      "params": {}
    },
    {
      "id": "press_feedback",
      "recipe": "press_release",
      "marker": "press",
      "offset": 0,
      "duration": 0.7,
      "bind": {
        "object": "panel"
      },
      "params": {}
    }
  ],
  "cue_actions": [
    {
      "marker": "answer",
      "layer": "title2",
      "offset": 0,
      "duration": 0.5,
      "op": "animate",
      "ease": "smooth",
      "values": {
        "y": 245
      }
    }
